# Modèle des réglages privés (emails, paiement Stripe).
# Pour la mise en ligne : copier ce fichier en ".env" (dans le dossier Back) et remplir les vraies valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (il contient des mots de passe).
# Sans fichier .env, les emails partent vers Mailpit (http://localhost:8025).

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=site@auxcreasdemarie.local
MAIL_TO=marie@auxcreasdemarie.local

# Paiement Stripe en MODE TEST (aucun vrai argent) : clé secrète "sk_test_…"
# à copier depuis le tableau de bord Stripe → Développeurs → Clés API.
STRIPE_SECRET_KEY=sk_test_a_remplacer

# Suivi des colis : clé de l'API Okapi de La Poste (developer.laposte.fr, demande un SIRET).
# Laisser vide : le site affiche alors un suivi de démonstration.
OKAPI_KEY=

# Connexion base de données.
DB_HOST=mysql
DB_NAME=auxcreasdemarie
DB_USER=creas_app
DB_PASSWORD=a_remplacer